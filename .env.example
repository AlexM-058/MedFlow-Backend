HOST=127.0.0.1
PORT=3001

# Frontend addresses (origins) allowed to call the Backend from a browser, comma-separated
# (read by src/httpConfig.ts). Exact HTTPS origins; plain HTTP only for localhost/127.0.0.1.
# Leave it out to use APP_ORIGIN, or the local defaults http://127.0.0.1:5173 and http://localhost:5173.
# Never set it to an empty value: the server would refuse to start. See AUTH_SETUP.md.
CORS_ORIGINS=http://localhost:5173

# Supabase → Project Settings → API
# Copy this file to Backend/.env and fill in the values.
# Never commit .env. Never put SUPABASE_SECRET_KEY in Frontend.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# MedFlow-AI cloud service (cloud/server.ts, `npm run dev` in MedFlow-AI), used by
# POST /cases/{id}/analysis. The Gemini key lives in MedFlow-AI/.env, not here.
# Local MVP: the AI agents run on this machine; keep this address private (never public).
AI_URL=http://127.0.0.1:8091

# Local MedGemma extraction service, used by POST /cases/{id}/documents.
# Real service: MedFlow-AI/edge/extraction_service (Python + FastAPI, see its README).
# Without Ollama: npx tsx scripts/mock-medgemma.ts (same port, 127.0.0.1:8090)
MEDGEMMA_URL=http://127.0.0.1:8090
